<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:background="?attr/backgroundColor"
>
    <include layout="@layout/wallpaper_backdrop"/>
    <ProgressBar
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:id="@+id/main_load"

    >
    </ProgressBar>

    <Button android:text="@string/error_connecting_reload"
            android:visibility="gone"
            android:focusable="true"
            android:clickable="true"
            android:backgroundTint="?attr/textColor"
            android:textColor="?attr/backgroundColor"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/main_reload_data_btt"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
    >
    </Button>
    <LinearLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/fragment_main_tv_root"
    >
        <!--<ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/background_svg"
                android:scaleType="centerCrop"
                app:tint="?attr/darkBar"
        >
        </ImageView>-->

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
        >
            <!-- Hero region (~47% of the screen): banner art fills it and the menu bar
                 floats on top, so the artwork reaches the top edge like the reference. -->
            <FrameLayout
                    android:id="@+id/tv_hero_holder"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="50"
            >
            <FrameLayout
                    android:id="@+id/tv_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    tools:visibility="visible"
            >
                <com.lagradost.shiro.ui.BottomFadeImageView
                        android:id="@+id/tv_banner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"
                />
                <!-- Light veil so the art reads as atmosphere, matching the scrim. -->
                <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.2"
                        android:background="@drawable/wallpaper_scrim"
                />
                <!-- Left readability gradient over ~55% of the width, behind the text. -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                    <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="55"
                            android:alpha="0.85"
                            android:background="@drawable/gradient_left"
                    />
                    <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="45"
                    />
                </LinearLayout>
                <!-- Top fade so the icon row stays visible. -->
                <View
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_gravity="top"
                        android:alpha="0.7"
                        android:background="@drawable/gradient_top"
                />
                <!-- The bottom dissolve is a real alpha mask on tv_banner itself
                     (BottomFadeImageView), revealing the wallpaper behind it. -->
                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="bottom"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="56dp"
                        android:layout_marginBottom="26dp"
                        android:paddingTop="20dp"
                >
                    <TextView
                            android:id="@+id/tv_hero_kicker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:alpha="0.85"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="?attr/textColor"
                            tools:text="NATIVE TITLE"
                    />
                    <TextView
                            android:id="@+id/tv_hero_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="620dp"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/textColor"
                            tools:text="FEATURED ANIME"
                    />
                    <TextView
                            android:id="@+id/tv_hero_synopsis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="620dp"
                            android:layout_marginTop="8dp"
                            android:textSize="14sp"
                            android:alpha="0.85"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/textColor"
                            tools:text="Synopsis text goes here"
                    />
                    <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="18dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                    >
                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/tv_hero_watch"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minWidth="170dp"
                                android:layout_marginEnd="16dp"
                                android:text="@string/home_watch_now_text"
                                android:background="@drawable/button_ripple"
                                android:foreground="@drawable/button_outline"
                                android:textColor="@color/white"
                                android:focusable="true"
                                android:clickable="true"
                                android:nextFocusDown="@id/vertical_grid_view"
                                android:nextFocusRight="@id/tv_hero_info"
                                app:icon="@drawable/netflix_play"
                                app:iconTint="@color/white"
                                app:iconSize="24dp"
                        />
                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/tv_hero_info"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minWidth="170dp"
                                android:text="@string/home_more_info_text"
                                android:theme="@style/Button.Black"
                                android:background="@drawable/button_ripple"
                                android:foreground="@drawable/button_outline"
                                android:textColor="@color/white"
                                android:focusable="true"
                                android:clickable="true"
                                android:nextFocusDown="@id/vertical_grid_view"
                                android:nextFocusLeft="@id/tv_hero_watch"
                                app:icon="@drawable/ic_baseline_info_24"
                                app:iconTint="@color/white"
                                app:iconSize="24dp"
                        />
                    </LinearLayout>
                    <LinearLayout
                            android:id="@+id/tv_hero_dots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp"
                            android:importantForAccessibility="no"
                    />
                </LinearLayout>
            </FrameLayout>
            <RelativeLayout
                    android:layout_margin="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:id="@+id/tv_menu_bar"
            >
                <!--
                <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/nekomo_logo"
                        android:layout_centerVertical="true"
                        android:id="@+id/shiro_logo"
                >
                </ImageView>
                -->

                <!--<com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="false"
                        app:strokeWidth="2dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:text="Settings"
                        app:strokeColor="?attr/textColor"
                        android:textColor="?attr/textColor"
                        android:id="@+id/settings_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/search_icon"
                >

                </com.google.android.material.button.MaterialButton>-->
                <ImageView
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@id/library_icon"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        app:srcCompat="@drawable/search_icon"
                        android:id="@+id/search_icon"
                        android:contentDescription="@string/title_search"
                        android:focusable="true"
                        android:nextFocusUp="@null"
                        android:nextFocusDown="@id/tv_hero_watch"
                        android:clickable="true"
                        android:focusableInTouchMode="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                >
                    <requestFocus/>
                </ImageView>
                <ImageView
                        android:layout_toLeftOf="@id/settings_icon"
                        android:layout_centerVertical="true"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:scaleX="0.5"
                        android:scaleY="0.5"
                        app:srcCompat="@drawable/ic_baseline_collections_bookmark_24"
                        android:id="@+id/library_icon"
                        android:contentDescription="@string/library"
                        android:focusable="true"
                        android:nextFocusDown="@id/tv_hero_watch"
                        android:clickable="true"
                        android:focusableInTouchMode="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="?attr/white">
                </ImageView>

                <ImageView
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:scaleX="0.5"
                        android:scaleY="0.5"
                        android:src="@drawable/settings_white"
                        android:id="@+id/settings_icon"
                        android:contentDescription="@string/title_settings"
                        android:focusable="true"
                        android:nextFocusDown="@id/tv_hero_watch"
                        android:clickable="true"
                        android:focusableInTouchMode="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="?attr/white"
                >
                </ImageView>


            </RelativeLayout>
            </FrameLayout>
            <androidx.leanback.widget.VerticalGridView
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="50"
                    android:orientation="vertical"
                    android:id="@+id/vertical_grid_view"
                    tools:listitem="@layout/vertical_grid_view_child"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />
        </LinearLayout>


    </LinearLayout>


</FrameLayout>
