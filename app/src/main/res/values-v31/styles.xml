<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: brand background, the app icon as the animated mark,
         then fall back to the normal app theme once content is drawn. -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBackground">#0d0714</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1c0f2a</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
