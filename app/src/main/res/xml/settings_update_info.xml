<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
>

    <Preference
            android:icon="@drawable/ic_baseline_build_24"
            app:key="version"
            app:title="Version"
    />
    <SwitchPreference
            app:key="auto_update"
            android:title="Check for updates on startup"
            android:summary="Shows a pop-up when a newer version is available"
            app:defaultValue="true"
            android:icon="@drawable/ic_baseline_system_update_24"
    />
    <SwitchPreference
            app:key="subscribe_to_updates"
            android:title="Subscribe to update notifications"
            app:defaultValue="false"
            android:icon="@drawable/ic_baseline_notifications_active_24"
    />

    <SwitchPreference
            app:key="beta_mode"
            android:title="Include pre-releases (stable app)"
            android:summary="Stable app: also offer pre-releases. The Beta and Debug apps always follow pre-releases, and only ever update to their own APK."
            app:defaultValue="false"
            android:icon="@drawable/ic_baseline_warning_24"
    />
    <EditTextPreference
            app:key="update_repos"
            android:title="Update repositories"
            android:dialogTitle="GitHub repositories (owner/repo, comma separated)"
            android:defaultValue="Nekomo-App/Nekomo,Nekomo-App/neko-source"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/ic_github_logo"
    />
    <Preference
            android:title="Check for update"
            android:icon="@drawable/rdload"
            app:key="check_updates"
    />
    <Preference
            android:title="Changelog"
            app:key="changelog"
            android:icon="@drawable/ic_baseline_notes_24"
    />

</PreferenceScreen>