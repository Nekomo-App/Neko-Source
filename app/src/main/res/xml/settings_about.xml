<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <Preference
            android:key="about_version"
            android:title="Version"
            android:icon="@drawable/ic_baseline_code_24"
            android:selectable="false"
    />
    <Preference android:title="Terms of Service" android:icon="@drawable/ic_baseline_code_24" app:summary="Rules for using Nekomo">
        <intent android:action="android.intent.action.VIEW" android:data="https://nekomoapp.netlify.app/terms"/>
    </Preference>
    <Preference android:title="Privacy Policy" android:icon="@drawable/ic_baseline_code_24" app:summary="What stays on your device">
        <intent android:action="android.intent.action.VIEW" android:data="https://nekomoapp.netlify.app/privacy"/>
    </Preference>
    <Preference android:title="DMCA / copyright" android:icon="@drawable/ic_baseline_code_24" app:summary="Nekomo hosts no content; report copyright concerns here">
        <intent android:action="android.intent.action.VIEW" android:data="https://nekomoapp.netlify.app/dmca"/>
    </Preference>
    <Preference android:title="Support" android:icon="@drawable/ic_baseline_code_24" app:summary="Get help">
        <intent android:action="android.intent.action.VIEW" android:data="https://nekomoapp.netlify.app/support"/>
    </Preference>
    <Preference
            android:title="Nekomo Discord"
            android:icon="@drawable/ic_baseline_discord_24"
            app:summary="Join the Nekomo community"
    >
        <intent android:action="android.intent.action.VIEW"
                android:data="https://discord.com/invite/E4Ezmgg7Ka"/>

    </Preference>
    <Preference
            android:title="Nekomo Telegram"
            android:icon="@drawable/ic_telegram"
            app:summary="Announcements and chat"
    >
        <intent android:action="android.intent.action.VIEW"
                android:data="https://t.me/nekomoapp"/>

    </Preference>
    <Preference
            android:title="GitHub"
            android:icon="@drawable/ic_github_logo"
            app:summary="Submit issues and contribute to the app">
        <intent android:action="android.intent.action.VIEW"
                android:data="https://github.com/Nekomo-App/neko-source"/>
    </Preference>
    <Preference
            android:title="Nekomo project"
            android:icon="@drawable/ic_github_logo"
            app:summary="https://github.com/Nekomo-App/Nekomo">
        <intent android:action="android.intent.action.VIEW"
                android:data="https://github.com/Nekomo-App/Nekomo"/>
    </Preference>
    <Preference
            android:title="Developer"
            android:icon="@drawable/ic_baseline_code_24"
            app:summary="marshmeadow — marshmeadow.netlify.app">
        <intent android:action="android.intent.action.VIEW"
                android:data="https://marshmeadow.netlify.app/"/>
    </Preference>
    <Preference
            android:title="Developer on GitHub"
            android:icon="@drawable/ic_github_logo"
            app:summary="https://github.com/MarshMeadow">
        <intent android:action="android.intent.action.VIEW"
                android:data="https://github.com/MarshMeadow"/>
    </Preference>
    <Preference
            android:title="Previous developers"
            android:icon="@drawable/ic_baseline_code_24"
            app:summary="Lag (LagradOst) &amp; Blue Fire (Blatzar) — original open-source project"
    />
    <Preference
            android:title="Light novel app by the original devs"
            android:icon="@drawable/quick_novel_icon"
            app:summary="https://github.com/LagradOst/QuickNovel">
        <intent android:action="android.intent.action.VIEW"
                android:data="https://github.com/LagradOst/QuickNovel"/>
    </Preference>
    <Preference
            android:title="Anime and Movie app by the original devs"
            android:icon="@drawable/cs3_cloud"
            app:summary="https://github.com/recloudstream/cloudstream">
        <intent android:action="android.intent.action.VIEW"
                android:data="https://github.com/recloudstream/cloudstream"/>
    </Preference>

</PreferenceScreen>
